#
# Cudy TR3000 构建配置（基于官方 OpenWrt openwrt-25.12 分支）
#
# 一次构建同时产出 4 款固件：
#   128M 标准版   -> cudy_tr3000-v1         （原厂布局，ubi 64M）
#   128M 大分区版 -> cudy_tr3000-mod        （U-Boot mod，ubi 112M，mod-112m 方案）
#   256M 标准版   -> cudy_tr3000-256mb-v1   （原厂布局，ubi 230M）
#   256M 大分区版 -> cudy_tr3000-256mb-mod  （U-Boot mod，ubi 240M）
#

# ---- 目标平台 ----
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# ---- 设备选择（大分区设备由 scripts/diy-part1.sh 注入） ----
CONFIG_TARGET_mediatek_filogic_DEVICE_cudy_tr3000-v1=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cudy_tr3000-mod=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cudy_tr3000-256mb-v1=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cudy_tr3000-256mb-mod=y

# ---- LuCI 与中文界面 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ---- 默认主题：Argon（4 款固件均内置，首次启动自动设为默认主题） ----
CONFIG_PACKAGE_luci-theme-argon=y

# ---- dnsmasq-full（OpenClash 强制依赖；替换默认 dnsmasq，避免依赖冲突） ----
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

# ---- 内置插件（18 款）按设备安装 ----
#   112M 大分区版 / 240M 大分区版 / 256M 标准版：内置全部插件
#     （清单与追加逻辑见 scripts/diy-part1.sh 的 TR3000_PLUGINS）
#   128M 标准版：仅内置主题（可用空间约 45M，装不下插件套件）
